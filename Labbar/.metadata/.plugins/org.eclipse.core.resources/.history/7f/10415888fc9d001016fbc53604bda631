void uart_print_menu()
{
	  qs_put_digits(0, 0, 0, 0, 1);

  const char menu[] = "\r\nChoose a mode:\r\n1. Clock mode\r\n2. Button mode\r\n";
  HAL_UART_Transmit(&huart2, (uint8_t*)menu, strlen(menu), HAL_MAX_DELAY);

}

int uart_get_menu_choice(void)
{
    uint8_t ch;
    if (HAL_UART_Receive(&huart2, &ch, 1, HAL_MAX_DELAY) != HAL_OK)
        return -1;

    HAL_UART_Transmit(&huart2, &ch, 1, 10);

    if (ch >= '0' && ch <= '9')
        return (int)(ch - '0'); 
    return -1;  
}

void uart_print_bad_choice()
{
  const char st[] = "\r\nInvalid choice. Try again.\r\n";
  HAL_UART_Transmit(&huart2, (uint8_t*)st, strlen(st), HAL_MAX_DELAY);
}

void HAL_GPIO_EXTI_Callback(uint16_t GPIO_Pin)
{
    if (GPIO_Pin == BTN_EXTI_Pin)
    {
        button_exti_count++;
        last_flank_time = HAL_GetTick();
        flank_pending = 1;
    }
}

#define BOUNCE_DELAY_MS 4

void button_mode()
{
	qs_put_big_num(0);

    while (1)
    {
        if (flank_pending)
        {
            uint32_t now = HAL_GetTick();
            if ((now - last_flank_time) >= BOUNCE_DELAY_MS)
            {
                int pressed = (HAL_GPIO_ReadPin(BTN_EXTI_GPIO_Port, BTN_EXTI_Pin) == GPIO_PIN_RESET);
                if (pressed)
                {
                    button_debounced_count++;

                }
                flank_pending = 0;
            }
        }




        if (HAL_GPIO_ReadPin(B1_GPIO_Port, B1_Pin) == GPIO_PIN_RESET)
        {
            qs_put_big_num(button_debounced_count);


        }
        else
        {
            qs_put_big_num(button_exti_count);

        }
    }
}


void clock_mode()
{
  uint8_t hours = 23;
  uint8_t minutes = 59;
  uint8_t seconds = 45;


  uint32_t last_tick = HAL_GetTick();

  uint8_t colon_on = 0;
  uint32_t colon_toggle = HAL_GetTick();

  while (1)
  {
    uint32_t now = HAL_GetTick();

    // räknar tiden
    if ((now - last_tick) >= 1000)
    {
      last_tick += 1000;

      seconds++;
      if (seconds >= 60)
      {
        seconds = 0;
        minutes++;
        if (minutes >= 60)
        {
          minutes = 0;
          hours++;
          if (hours > 23) hours = 0;
        }
      }
    }

    // toggla kolon varje  500 ms

    if ((now - colon_toggle) >= 500)
    {
      colon_on = 0;
      colon_toggle += 500;
    }

    if (HAL_GPIO_ReadPin(B1_GPIO_Port, B1_Pin) == GPIO_PIN_SET)
    {
    	// show hours and minutes
    	uint8_t s_hour_0 = hours / 10;
    	uint8_t s_hour_1 = hours % 10;
    	uint8_t s_mins_0 = minutes / 10;
    	uint8_t s_mins_1 = minutes % 10;
    	qs_put_digits(s_hour_0, s_hour_1, s_mins_0, s_mins_1, colon_on);
    }
    else
    {	// show minutes and seconds
    	uint8_t s_mins_0 = minutes / 10;
  	  	uint8_t s_mins_1 = minutes % 10;
  	  	uint8_t s_sec_0	= seconds / 10;
		uint8_t s_sec_1 = seconds % 10;
    	qs_put_digits(s_mins_0, s_mins_1, s_sec_0, s_sec_1, colon_on);

    }
  }
}



